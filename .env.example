# Copy this file to .env and insert your remotely managed Cloudflare Tunnel token.
# Do not commit or share .env. This is a tunnel token, NOT a Cloudflare API token.
CLOUDFLARE_TUNNEL_TOKEN=

CACHE_TTL_SECONDS=600
STALE_TTL_SECONDS=86400

# Optional: pin an image tag/digest for reproducible cloudflared deployments.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
